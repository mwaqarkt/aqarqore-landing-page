# ---------------------------------------------------------------------------
# AqarQore — Apache config for the Next.js static export (output: 'export')
# Deployed to /home/<user>/domains/aqarqore.com/public_html
# ---------------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# --- Canonical host: strip www and force HTTPS in a single hop --------------
# Every canonical tag on the site is https://aqarqore.com (no www), so the
# server must agree or the www host becomes a duplicate of the whole site.
#
# The www rule runs FIRST and jumps straight to https on the apex. Forcing
# HTTPS first would preserve the www host and send http://www through two
# redirects (http://www -> https://www -> https://apex), wasting crawl budget.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- Branded 404 -----------------------------------------------------------
ErrorDocument 404 /404.html

# --- Caching ---------------------------------------------------------------
<IfModule mod_headers.c>
  # Next.js emits content-hashed filenames under /_next/static, so these can be
  # cached indefinitely. A new build produces new filenames.
  <FilesMatch "\.(js|mjs|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images are not content-hashed; one month with revalidation.
  <FilesMatch "\.(avif|webp|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML must revalidate so content edits go live on the next request.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # HSTS. Deliberately WITHOUT includeSubDomains: autodiscover.aqarqore.com and
  # autoconfig.aqarqore.com serve HTTP but fail on HTTPS, so forcing HTTPS on
  # subdomains would break mail-client autodiscovery for Outlook and Thunderbird.
  # Revisit only if those hostnames gain working certificates.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Baseline security headers.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Correct MIME types for next-gen formats -------------------------------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
